#include <vector>

class Image{
	public:
		Image(int width,int height);

		int width() const;
		int height() const;

		void clear(const Color& color);
		void setPixel(int x,int y,const Color& color);
		const Color& getPixel(int x,int y) const;

		void savePPM(const std::string& path) const;

	private:
		int width_;
		int height_;
		std::vector<Color> pixels_;
};
